// --------------------------------------------------------
//  ARCHIVO DE CONFIGURACIÓN DE BASE DE DATOS (FLoRa)
// --------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========================================================
// 1. ACTORES Y PROPIETARIOS
// ========================================================

model Usuario {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String   
  nombre    String?
  foto      String?
  
  // Relaciones de Propiedad (Mis cosas)
  motas     Mota[]    // Mis sensores
  routers   Router[]  // Mis antenas/gateways
  parcelas  Parcela[] // Mis tierras
  
  createdAt DateTime  @default(now())
}

// ========================================================
// 2. CATÁLOGOS AGRONÓMICOS (Variables del Algoritmo)
// ========================================================

model TipoSuelo {
  id               Int       @id @default(autoincrement())
  nombre           String    @unique // Ej: "Franco-Arenoso", "Arcilloso"
  capacidadCampo   Float     // % máximo de agua útil que retiene
  puntoMarchitez   Float     // % mínimo antes de que la planta sufra
  laminaMaximaRiego Float? //Dosis maxima en mm por metro cuadrado adecuada para la parcela
  
  parcelas         Parcela[] 
}

model TipoCultivo {
  id               Int       @id @default(autoincrement())
  nombre           String    @unique // Ej: "Tomate", "Pimiento"
  kcBase           Float     // Coeficiente de cultivo base para la fórmula
  humedadObjetivo  Float     // % ideal de humedad que queremos mantener
  
  parcelas         Parcela[]
}

model TipoRiego {
  id               Int       @id @default(autoincrement())
  nombre           String    @unique // Ej: "Goteo", "Aspersión"
  eficiencia       Float     // Ej: 0.90, 0.75
  
  parcelas         Parcela[]
}

// ========================================================
// 3. INFRAESTRUCTURA DE RED (LOS ROUTERS)
// ========================================================

model Router {
  id                Int      @id @default(autoincrement())
  codigoVinculacion String   @unique // Usado para apropiarse del dispositivo
  nombre            String?  // Ej: "FLoRa Hub Norte"
  modelo            String   // Ej: "FLoRa Hub 2G"
  ssid              String?  // Nombre de la red LoRa/WiFi
  canal             Int?     // Ej: "0 --> 868100000 hz "

  // Para que el hardware hable con tu API
  apiToken          String   @unique
  
  // --- ROAMING Y COMUNIDAD ---
  esPublico         Boolean? @default(false) 
  
  // --- UBICACIÓN ---
  latitud           Float?
  longitud          Float?   

  // --- UBICACIÓN LÓGICA ---
  parcelaId         Int?
  parcela           Parcela? @relation(fields: [parcelaId], references: [id], onDelete: SetNull)

  // --- ESTADO Y SALUD ---
  bateria           Int?
  cvgGPRS           Int?     
  fechaUltimaConexion DateTime?
  
  // --- CONTADORES DE TRÁFICO ---
  paquetesEnviados  Int      @default(0) 
  paquetesRecibidos Int      @default(0) 
  erroresTx         Int      @default(0) 
  erroresRx         Int      @default(0) 
  erroresCrc        Int      @default(0)
  erroresCriptograficos Int      @default(0) 
  erroresCanalOcupado Int      @default(0) 
  erroresColaLlena Int      @default(0)
  


  // Relaciones
  usuarioId         Int?     
  usuario           Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  
  motasConectadas   Mota[] 
  reportes          ReporteRouter[]

  // --- MODIFICACIONES EN LA CONFIGURACION ---
  versionAplicada Int      @default(0) 
  configPendiente ConfiguracionPendiente?

  createdAt         DateTime @default(now()) 
  claimedAt         DateTime? 
}

// ========================================================
// 4. ZONAS DE CULTIVO (LÓGICA DE NEGOCIO)
// ========================================================

model Parcela {
  id             Int      @id @default(autoincrement())
  nombre         String   // Ej: "Sector Olivos A"
  humedadMedia   Float?   // Caché de estado (Calculado automáticamente)
  fechaActualizacionHumedad DateTime? // Caché de estado (Calculado automáticamente)
  
  // --- INFRAESTRUCTURA Y AGRONOMÍA ---
  areaM2         Float   // Calculado desde el mapa
  caudalRiegoLh  Float   // Litros/hora del sistema del usuario
  laminaMaximaRiego Float? //Dosis maxima en mm por metro cuadrado adecuada para la parcela
  humedadObjetivo   Float? // % de humedad objetivo específica de esta parcela

  sueloId        Int
  suelo          TipoSuelo   @relation(fields: [sueloId], references: [id], onDelete: SetNull)

  cultivoId      Int
  cultivo        TipoCultivo @relation(fields: [cultivoId], references: [id], onDelete: SetNull)

  riegoId        Int
  riego          TipoRiego   @relation(fields: [riegoId], references: [id], onDelete: SetNull)

  zonaHoraria        String? @default("Europe/Madrid")

  // --- UBICACIÓN ESPACIAL ---
  latitudCentro  Float
  longitudCentro Float
  puntos         Json    // Array de coordenadas del polígono: [[lat,lng], [lat,lng]...]
  
  // Relaciones
  usuarioId      Int
  usuario        Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  
  motas          Mota[]  
  routers        Router[] 
  historico      HistoricoParcela[]

  turnos         TurnoRiego[]
}

// ========================================================
// 5. DISPOSITIVOS DE CAMPO (LAS MOTAS)
// ========================================================

model Mota {
  id                Int      @id @default(autoincrement())
  codigoVinculacion String   @unique 
  nombre            String?  // Ej: "FLoRa Seed #4"
  modelo            String?  // Ej: "FLoRa Seed v1.0"
  frecuencia        Int? @default(240)  // Ej: "15 min -- siempre en minutos, 4h por defecto"

  conexionPublica   Boolean? @default(false) 

  // --- PROPIEDAD ---
  usuarioId         Int?       
  usuario           Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  // --- UBICACIÓN LÓGICA ---
  parcelaId         Int?     
  parcela           Parcela? @relation(fields: [parcelaId], references: [id], onDelete: SetNull) 

  // --- UBICACIÓN FÍSICA ---
  latitud           Float?   
  longitud          Float?   

  // --- CONECTIVIDAD ---
  routerId          Int?     
  router            Router?  @relation(fields: [routerId], references: [id], onDelete: SetNull)
  
  // --- CACHÉ DE ESTADO ---
  humedad           Float?   
  bateriaUltima     Int?
  rssi              Int?     
  snr               Float?
  paquetesEnviados  Int      @default(0) 
  paquetesRecibidos Int      @default(0)
  erroresTx     Int?     @default(0)     
  erroresRx     Int?     @default(0) 
  erroresCriptograficos Int? @default(0)
  erroresCrc    Int?     @default(0) 
  erroresCanalOcupado Int? @default(0)
  erroresACKfaltante Int? @default(0) 

  fechaUltimaConexion DateTime?
  mediciones        Medicion[]

  // --- MODIFICACIONES EN LA CONFIGURACION ---
  versionAplicada Int      @default(0) 
  configPendiente ConfiguracionPendiente?
  
  

  createdAt         DateTime @default(now()) 
  claimedAt         DateTime? 
}

// ========================================================
// 6. DATOS HISTÓRICOS (BIG DATA)
// ========================================================

model Medicion {
  id            Int      @id @default(autoincrement())
  fecha         DateTime @default(now())
  
  humedad       Float
  bateria       Int      
  rssi          Int?     
  snr           Float?  
  paquetesEnviados  Int?
  paquetesRecibidos Int?
  erroresTx     Int?        
  erroresRx     Int?    
  erroresCriptograficos Int? 
  erroresCrc    Int?
  erroresCanalOcupado Int?
  erroresACKfaltante Int? 

  motaId        Int
  mota          Mota     @relation(fields: [motaId], references: [id], onDelete: Cascade)

  @@index([fecha])
  @@index([motaId])
}

// ========================================================
// 7. LOGS DE INFRAESTRUCTURA (ROUTERS)
// ========================================================

model ReporteRouter {
  id                Int      @id @default(autoincrement())
  fecha             DateTime @default(now())
  
  bateria           Int?
  cvgGPRS           Int?
  paquetesEnviados  Int
  paquetesRecibidos Int
  erroresTx         Int
  erroresRx         Int
  erroresCrc        Int
  erroresCriptograficos Int?
  erroresCanalOcupado Int? 
  erroresColaLlena Int? 
  
  routerId          Int
  router            Router   @relation(fields: [routerId], references: [id], onDelete: Cascade)

  @@index([fecha])
  @@index([routerId])
}

// ========================================================
// 8. HISTÓRICO DE PARCELAS (AGREGADOS)
// ========================================================

model HistoricoParcela {
  id            Int      @id @default(autoincrement())
  fecha         DateTime @default(now())
  
  humedadMedia  Float    
  
  parcelaId     Int
  parcela       Parcela  @relation(fields: [parcelaId], references: [id], onDelete: Cascade)

  @@index([fecha])
  @@index([parcelaId])
}


// ========================================================
// 9. TURNOS DE RIEGO (PARCELAS)
// ========================================================
model TurnoRiego {
  id                  Int       @id @default(autoincrement())
  horaConfigurada     String    // Ej: "06:00", "14:00"

  // El caché del algoritmo se mueve aquí, a nivel de turno
  proximoRiego        DateTime? 
  tiempoRiegoMin      Int?      
  estadoRiego         String?   
  proximaEjecucionUTC DateTime?

  // Relación con la parcela
  parcelaId           Int
  parcela             Parcela   @relation(fields: [parcelaId], references: [id], onDelete: Cascade)
}

// ========================================================
// 9. TURNOS DE RIEGO (PARCELAS)
// ========================================================

model CacheClima {
  // El ID será un string con este formato: "37.39_-5.98"
  gridId      String   @id 
  
  // Guardamos el JSON crudo que nos devuelve Open-Meteo
  datos       Json     
  
  // Para saber si ha caducado
  actualizado DateTime @default(now()) @updatedAt 
}

// ========================================================
// 10. SINCRONIZACION OTA (OVER-THE-AIR)
// ========================================================

model ConfiguracionPendiente {
  id        Int      @id @default(autoincrement())
  
  // O es para una Mota...
  motaId    Int?     @unique
  mota      Mota?    @relation(fields: [motaId], references: [id], onDelete: Cascade)
  
  // ... o es para un Router. (Prisma permite que uno sea null)
  routerId  Int?     @unique
  router    Router?  @relation(fields: [routerId], references: [id], onDelete: Cascade)
  
  version   Int      
  payload   Json     

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}